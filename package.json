{
    "name": "obsidian-word-count",
    "version": "1.0.0",
    "description": "A writing statisics and word count plugin for obsidian.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "check": "tsc --noEmit -skipLibCheck"
    },
    "keywords": [
        "obsidian",
        "word-count",
        "writing",
        "statisics"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^22.0.0",
        "builtin-modules": "^5.3.0",
        "esbuild": "^0.28.2",
        "obsidian": "latest",
        "typescript": "^5.9.3"
    }
}